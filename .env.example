# Environment Variables for Ask Divyansh AI
# Copy this file to .env and set your Google Gemini API key or OpenAI API key.

# Google Gemini API Key (Recommended - Free & Fast from Google AI Studio)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Or OpenAI API Key (Optional alternative)
# OPENAI_API_KEY=your_openai_api_key_here
